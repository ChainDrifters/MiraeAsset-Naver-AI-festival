# -----------------------------
# Neo4j
# -----------------------------

NEO4J_URI=
NEO4J_DATABASE=
NEO4J_USER=
NEO4J_PASSWORD=
# Required in addition to the CLI --authorize-write gate. Exact value: YES.
MIRAE_ALLOW_NEO4J_WRITE=
# Deployment-owned staging destination pins. Load requires exact matches.
# Remote staging requires neo4j+s and a non-generic database. A disposable
# local Community container may use neo4j:// plus database neo4j only when the
# pinned host is exactly localhost, 127.0.0.1, or ::1.
MIRAE_STAGING_NEO4J_URI=
MIRAE_STAGING_NEO4J_DATABASE=

NEO4J_BIND_IP=0.0.0.0
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_PROXY_PORT=8443

# OpenDART API key for official disclosure ingestion; keep empty in examples.
OPENDART_API_KEY=
# SSH destination for raw artifact transfer in user@host form.
MIRAE_RAW_REMOTE=
# Remote root directory for raw artifact storage.
MIRAE_RAW_ROOT=
# Optional Neo4j URI for route smoke tests.
MIRAE_TEST_NEO4J_URI=

# Identifying contact used for SEC fair-access requests (email or HTTPS URL).
SEC_USER_AGENT=
# Identifying contact used for manager holdings requests (email or HTTPS URL).
MANAGER_USER_AGENT=
